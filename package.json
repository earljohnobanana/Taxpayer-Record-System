{
  "name": "taxpayer-record-system",
  "version": "1.0.0",
  "description": "LGU Taxpayer Record Management System – Santa Catalina, Negros Oriental",
  "author": "Municipal Treasurer's Office – Santa Catalina, Negros Oriental",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "cross-env NODE_ENV=development node --watch server/index.js",
    "dev:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:3001/api/health && cross-env NODE_ENV=development electron .",
    "build": "vite build --config client/vite.config.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env NODE_ENV=development node server/database/migrate.js",
    "db:seed": "cross-env NODE_ENV=development node server/database/seed.js",
    "start": "cross-env NODE_ENV=production electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-table": "^8.20.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^3.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ph.gov.santacatalina.mto.taxpayer",
    "productName": "Taxpayer Record System",
    "copyright": "Municipal Treasurer's Office – Santa Catalina, Negros Oriental",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taxpayer Record System",
      "artifactName": "TaxpayerRecordSystem-Setup-${version}.${ext}"
    }
  }
}
